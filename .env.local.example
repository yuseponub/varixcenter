# Supabase Configuration
# Get these values from: https://supabase.com/dashboard -> Project Settings -> API

# Public URL - safe to expose in browser
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Public anon key - safe to expose in browser (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - NEVER expose in browser (bypasses RLS)
# Only use in Server Actions, API routes, and backend services
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Outlook / Microsoft 365 calendar synchronization
# Keep disabled until migration 065 and the Microsoft app are ready.
ENABLE_OUTLOOK_SYNC=false
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_CLIENT_SECRET=your-app-client-secret
OUTLOOK_MAILBOX=agenda@your-domain.com
OUTLOOK_CALENDAR_ID=calendar

# Public production URL. OUTLOOK_WEBHOOK_URL is optional when this is set.
NEXT_PUBLIC_APP_URL=https://your-varix-domain.com
# OUTLOOK_WEBHOOK_URL=https://your-varix-domain.com/api/integrations/outlook/webhook
OUTLOOK_WEBHOOK_CLIENT_STATE=generate-a-long-random-secret

# Delta window and Vercel cron authentication
OUTLOOK_SYNC_PAST_DAYS=30
OUTLOOK_SYNC_FUTURE_DAYS=400
CRON_SECRET=generate-a-different-long-random-secret
