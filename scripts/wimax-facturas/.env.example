SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=service-role-key
WIMAX_DIR=C:\wimax\CENTER26

# Robot UI. Mantener false hasta que el perfil se calibre y se pruebe con una
# factura de ensayo controlada.
WIMAX_ROBOT_ENABLED=false
WIMAX_UI_PROFILE=robot-profile.contabilidad.json
WIMAX_STATE_DIR=state
WIMAX_AGENT_ID=contabilidad-session1
WIMAX_POLL_SECONDS=30
WIMAX_MIN_IDLE_SECONDS=300
WIMAX_ALLOWED_HOURS=
WIMAX_APPROVAL_TIMEOUT_MINUTES=120
WIMAX_VERIFY_TIMEOUT_SECONDS=120
WIMAX_CUFE_GRACE_SECONDS=15
WIMAX_SCREENSHOT_RETENTION_HOURS=24

# "Crear ahora" muestra una solicitud en el escritorio. Si no se responde no
# toca WiMAX y vuelve a recordar despues del intervalo configurado.
WIMAX_URGENT_PROMPT_TIMEOUT_SECONDS=45
WIMAX_URGENT_REMINDER_SECONDS=300

# Lote diario. La ventana cruza medianoche; solo factura con sesion desbloqueada,
# WiMAX limpio y el escritorio inactivo. El apagado requiere cola y conciliacion
# completamente cerradas y muestra un aviso cancelable durante 60 segundos.
WIMAX_END_OF_DAY_ENABLED=false
WIMAX_END_OF_DAY_TIME=21:00
WIMAX_END_OF_DAY_WINDOW_MINUTES=360
WIMAX_END_OF_DAY_MIN_IDLE_SECONDS=600
WIMAX_END_OF_DAY_QUIET_SECONDS=120
WIMAX_END_OF_DAY_SHUTDOWN=false
WIMAX_SHUTDOWN_DELAY_SECONDS=60

# Conciliacion de CUFE ya emitidos. Estas credenciales solo viven en el .env
# del PC WiMAX; nunca se copian al repositorio ni a Supabase.
COLFACT_RECONCILE_ENABLED=false
COLFACT_BASE_URL=https://nube.conexusit.com/admin
COLFACT_USERNAME=
COLFACT_PASSWORD=
COLFACT_EMISOR_NIT=
COLFACT_HTTP_TIMEOUT_SECONDS=30
COLFACT_LOOKUP_TIMEOUT_SECONDS=5
COLFACT_LOOKUP_POLL_SECONDS=3
COLFACT_POST_BATCH_DELAY_SECONDS=120
COLFACT_POST_BATCH_ATTEMPTS=3
COLFACT_RECONCILE_LIMIT=10
