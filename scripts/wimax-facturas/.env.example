SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=service-role-key
WIMAX_DIR=C:\wimax\CENTER26

# Robot UI (siempre supervisado en esta version). Mantener false hasta que el
# perfil se calibre y se pruebe con una factura de ensayo supervisada.
WIMAX_ROBOT_ENABLED=false
WIMAX_UI_PROFILE=robot-profile.contabilidad.json
WIMAX_STATE_DIR=state
WIMAX_AGENT_ID=contabilidad-session1
WIMAX_POLL_SECONDS=30
WIMAX_MIN_IDLE_SECONDS=300
WIMAX_ALLOWED_HOURS=
WIMAX_APPROVAL_TIMEOUT_MINUTES=120
WIMAX_VERIFY_TIMEOUT_SECONDS=120
WIMAX_CUFE_GRACE_SECONDS=15
WIMAX_SCREENSHOT_RETENTION_HOURS=24

# Conciliacion de CUFE ya emitidos. Estas credenciales solo viven en el .env
# del PC WiMAX; nunca se copian al repositorio ni a Supabase.
COLFACT_RECONCILE_ENABLED=false
COLFACT_BASE_URL=https://nube.conexusit.com/admin
COLFACT_USERNAME=
COLFACT_PASSWORD=
COLFACT_EMISOR_NIT=
COLFACT_HTTP_TIMEOUT_SECONDS=30
COLFACT_LOOKUP_TIMEOUT_SECONDS=90
COLFACT_LOOKUP_POLL_SECONDS=3
COLFACT_RECONCILE_LIMIT=10
