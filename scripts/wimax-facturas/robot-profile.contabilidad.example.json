{
  "version": 1,
  "calibrated": true,
  "sessionId": 1,
  "display": {
    "width": 1920,
    "height": 1080
  },
  "window": {
    "process": "WX",
    "titlePattern": "^\\s*Wimax Software",
    "classPattern": "^XbpDialog$"
  },
  "notes": [
    "Perfil calibrado en CONTABILIDAD el 24-07-2026, sesion 1, 1920x1080.",
    "El arranque autenticado selecciona y verifica el prefijo FE antes de estos flujos.",
    "Aceptar Asignacion de asiento contable es el primer paso irreversible.",
    "Si cambia WiMAX, la resolucion, los titulos o la estructura de controles, poner calibrated=false."
  ],
  "flows": {
    "openInvoice": [
      {
        "name": "enfocar-principal",
        "action": "focus",
        "target": {
          "process": "WX",
          "titlePattern": "^\\s*Wimax Software",
          "classPattern": "^XbpDialog$"
        }
      },
      {
        "name": "abrir-facturacion-atomico",
        "action": "keys",
        "target": {
          "foreground": true,
          "process": "WX",
          "titlePattern": "^\\s*Wimax Software",
          "classPattern": "^XbpDialog$"
        },
        "keys": "%m{DOWN}{RIGHT}{ENTER}",
        "delayMs": 1500,
        "expectTimeoutMs": 30000,
        "expect": {
          "foreground": true,
          "process": "WX",
          "titlePattern": "^\\s*Facturaci.n",
          "classPattern": "^XbpDialog$"
        },
        "capture": true
      },
      {
        "name": "esperar-carga-archivos-facturacion",
        "action": "waitTextAbsent",
        "target": {
          "process": "WX",
          "titlePattern": "^\\s*Wimax Software",
          "classPattern": "^XbpDialog$"
        },
        "textPattern": "Abriendo archivos",
        "timeoutMs": 60000,
        "stableMs": 3000
      }
    ],
